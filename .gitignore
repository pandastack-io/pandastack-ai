# build artefacts
bin/
dist/
node_modules/
*.log

# stray go build outputs (when `go build` runs without -o in a package dir)
/agent/agent
/agent/migrate
/agent/pandastack-daemon
/agent/pandastack-init
/cmd/pandastack/cli
/api/api
/db-proxy/db-proxy

# go
agent/vendor/
api/vendor/

# editor
.vscode/
.idea/
.DS_Store

# local data
*.db
*.sqlite

# Local environment files (never commit secrets)
# Catch all .env variants; whitelist the safe examples below.
.env
.env.*
*.env
*.env.*
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template
!.env.local.example
!**/.env.example

# Python virtualenvs (third-party stdlib pulls trigger secret scanners)
.venv/
venv/
**/.venv/
**/__pycache__/
*.pyc

# Terraform state + plans + vars (NEVER commit — contain real credentials/JWTs)
# A saved plan file is a serialized copy of the resource graph: it embeds
# attribute values and the variables that produced them, including anything
# marked `sensitive`. Ignore every spelling a `terraform plan -out=` produces.
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.plan
tfplan*
*.out
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.tftpl
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Next.js / dashboard build output
.next/
out/
.vercel/
.open-next/
docs-site/out/
dashboard/.wrangler/*
.npmrc

# fumadocs-mdx generated source (regenerated on next dev/build)
docs-site/.source/
# Lima / Firecracker local artifacts
*.qcow2
*.img
*.snap

# Copilot session planning file
plan.md

# Local runtime state (tokens, session data)
.local-state/
# Operator scratch dirs that hold live tokens / request bodies. These are not
# part of the open-source tree; ignoring them keeps a stray local copy from
# ever being staged.
.run/
gtm/
tools/
templates/postgres-16/query-broker/query-broker
db-proxy/db-proxy
docs-site/next-env.d.ts
